# ============================================================================
# ADS-B Kalman Guard - Environment Configuration Template
# Copy this file to '.env' and set your receiver coordinates
# ============================================================================

# 1. Reference Antenna Origin (WGS84 Decimal Degrees & Altitude in Meters)
# Default below is set to Brussels Airport
REF_LAT=50.9014
REF_LON=4.4844
REF_ALT_M=56.0

# 2. Telemetry Stream Mode ('replay' for sample file, 'live' for RTL-SDR / readsb)
STREAM_MODE=replay
SAMPLE_PATH=sample_data/brussels_live.ndjson

# 3. Live readsb TCP JSON Source (used when STREAM_MODE=live)
READSB_HOST=127.0.0.1
READSB_PORT=30047

# 4. WebSocket Bridge Port & Initial Spoof Target ('NONE', 'ANY', or ICAO hex)
WS_PORT=8080
SPOOF_HEX=NONE

# 5. Optional Cloudflare Tunnel Token (used with --profile prod)
CF_TUNNEL_TOKEN=